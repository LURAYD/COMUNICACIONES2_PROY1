- name: lector
  id: epy_module
  parameters:
    source_code: |
      """Lector de la corrida: lee parametros.txt y deja todo listo para los bloques.

      Este código lo ejecuta GNU Radio (con su propio Python), no el proyecto.
      Solo depende de numpy y de gnuradio. Vive dentro del flowgraph (bloque
      Python Module «lector»); para cambiarlo, doble clic en ese bloque.

      - ruta(parametros): qué parametros.txt usar. Si el flowgraph se lanza con
        --parametros, ese; si se ejecuta desde Companion, abre un diálogo para
        elegirlo (así se cargan corridas nuevas sin tocar el flowgraph).
      - leer(ruta): diccionario con los valores, ya convertidos a número.
      """

      import os

      import numpy as np

      # Valores por defecto: los usa Companion mientras se edita el flowgraph (no
      # hay corrida elegida todavía) para poder mostrar y validar los bloques.
      DEFECTO = {
          "modulacion": "qpsk", "fs": 1e6, "sps": 8, "rolloff": 0.35, "span": 10,
          "zc_len": 64, "n_train": 512, "n_payload": 4000, "guard": 64,
          "ebn0_db": 12.0, "noise_voltage": 0.0, "cfo_hz": 0.0, "fase_grados": 0.0,
          "reloj_ppm": 0.0, "retardo_frac": 0.0, "rayleigh": 0,
          "taps_canal": [1 + 0j], "eq_taps": 21, "eq_mu": 0.5, "semilla": 2026,
          "escenario": "?", "perfil": "?",
      }


      _avisados = set()


      def _aqui():
          try:
              return os.path.dirname(os.path.abspath(__file__))
          except NameError:  # Companion evalúa este código sin __file__
              return os.getcwd()


      def ruta(parametros=""):
          """Ruta del parametros.txt de la corrida."""
          if parametros:
              return os.path.abspath(parametros)
          inicio = os.path.join(_aqui(), "corridas")
          # Solo hay QApplication cuando el flowgraph se EJECUTA con interfaz Qt;
          # mientras Companion edita no la hay y no se abre ningún diálogo.
          try:
              from PyQt5 import Qt
              app = Qt.QApplication.instance()
          except Exception:
              app = None
          if app is not None:
              f, _ = Qt.QFileDialog.getOpenFileName(
                  None, "Elige el parametros.txt de la corrida", inicio,
                  "Parámetros de corrida (parametros.txt);;Texto (*.txt)")
              if f:
                  return f
              print("[lector] No se eligió ninguna corrida: se usa la de ejemplo.")
          # La de ejemplo, buscada junto al flowgraph o desde la raíz del proyecto
          # (desde donde lo abre «Abrir en GNU Radio.bat»).
          # Al editar, Companion no da __file__ ni un directorio fiable, pero su
          # linea de ordenes lleva la ruta del .grc abierto: la corrida esta al lado.
          import sys
          bases = [_aqui(), os.path.join(os.getcwd(), "grc")]
          bases += [os.path.dirname(os.path.abspath(a)) for a in sys.argv if a.endswith(".grc")]
          for base in bases:
              f = os.path.join(base, "corridas", "ejemplo", "parametros.txt")
              if os.path.isfile(f):
                  return f
          return os.path.join(inicio, "ejemplo", "parametros.txt")


      def _valor(v):
          if "," in v:
              try:
                  return [complex(x) for x in v.split(",") if x.strip()]
              except ValueError:
                  return v
          for conv in (int, float, complex):
              try:
                  return conv(v)
              except ValueError:
                  pass
          return v


      def leer(ruta_txt):
          """Diccionario con los parámetros de la corrida."""
          P = dict(DEFECTO)
          P["carpeta"] = os.path.dirname(os.path.abspath(ruta_txt))
          if not os.path.isfile(ruta_txt):
              # Companion evalúa las variables muchas veces al editar: avisar una.
              if ruta_txt not in _avisados:
                  _avisados.add(ruta_txt)
                  print("[lector] No existe %s: se usan valores por defecto." % ruta_txt)
              P["valida"] = False
              return P
          with open(ruta_txt, encoding="utf-8") as fh:
              for linea in fh:
                  linea = linea.split("#", 1)[0].strip()
                  if "=" in linea:
                      k, v = linea.split("=", 1)
                      P[k.strip()] = _valor(v.strip())
          if not isinstance(P["taps_canal"], list):   # un solo coeficiente
              P["taps_canal"] = [complex(P["taps_canal"])]
          P["valida"] = True
          os.makedirs(os.path.join(P["carpeta"], "gnuradio"), exist_ok=True)
          if ruta_txt in _avisados:
              return P
          _avisados.add(ruta_txt)
          print("[lector] Corrida: %s" % P["carpeta"])
          print("[lector]   escenario %s, canal %s, %s, Eb/N0 = %s dB, ruido v = %.4f"
                % (P["escenario"], P["perfil"], str(P["modulacion"]).upper(),
                   P["ebn0_db"], P["noise_voltage"]))
          if P["retardo_frac"] or P["rayleigh"]:
              print("[lector]   AVISO: retardo fraccional y Rayleigh no se reproducen en GNU Radio.")
          return P


      def archivo(P, nombre):
          """Fichero de entrada de la corrida (lo escribió Python)."""
          return os.path.join(P["carpeta"], nombre)


      def n_muestras(P, nombre):
          """Longitud en muestras complex64 de un fichero de la corrida."""
          f = archivo(P, nombre)
          return max(os.path.getsize(f) // 8, 1) if os.path.isfile(f) else 1


      def salida(P, nombre):
          """Fichero que escribe GNU Radio, en la subcarpeta gnuradio/."""
          return os.path.join(P["carpeta"], "gnuradio", nombre)


      def rrc(P):
          """RRC de GNU Radio con span*sps+1 coeficientes y energía 1, como en Python.

          firdes normaliza a ganancia en continua 1 (suma = 1); Python normaliza a
          energía 1 (suma de cuadrados = 1). Se reescala para que las dos señales
          tengan la misma potencia y el mismo noise_voltage signifique lo mismo.
          """
          from gnuradio.filter import firdes
          sps, span = int(P["sps"]), int(P["span"])
          h = np.array(firdes.root_raised_cosine(1.0, sps, 1.0, P["rolloff"], span * sps + 1))
          return list(h / np.sqrt(np.sum(h ** 2)))


      def rrc_polifase(P, nfilts):
          """Filtro adaptado para el Polyphase Clock Sync (interpolado por nfilts).

          Cada rama se escala a energía 1, como el filtro adaptado de Python: así
          un símbolo de energía 1 sale con amplitud 1 y el umbral del Correlation
          Estimator no depende de la normalización de firdes.
          """
          from gnuradio.filter import firdes
          sps, span = int(P["sps"]), int(P["span"])
          h = np.array(firdes.root_raised_cosine(nfilts, nfilts * sps, 1.0, P["rolloff"],
                                                 (span * sps + 1) * nfilts))
          return list(h / np.sqrt(np.sum(h[::nfilts] ** 2)))


      def giro(P):
          """Fase fija del canal como factor complejo."""
          return complex(np.exp(1j * np.radians(P["fase_grados"])))


      def entrenamiento(P):
          """Secuencia de entrenamiento: la sacan de simbolos_tx.cf32."""
          f = archivo(P, "simbolos_tx.cf32")
          if not os.path.isfile(f):
              return [1 + 0j] * 64
          s = np.fromfile(f, dtype=np.complex64)
          i0 = int(P["guard"]) + 2 * int(P["zc_len"])
          return [complex(x) for x in s[i0: i0 + int(P["n_train"])]]


      def constelacion(P):
          """Constelación de decisión, la misma de Python (energía media 1)."""
          from gnuradio import digital
          m = {"bpsk": 2, "qpsk": 4, "8psk": 8, "16qam": 16, "64qam": 64}[str(P["modulacion"]).lower()]
          if str(P["modulacion"]).endswith("qam"):
              L = int(round(np.sqrt(m)))
              niv = 2 * np.arange(L) - (L - 1)
              pts = (niv[:, None] + 1j * niv[None, :]).ravel()
              rot = 4
          else:
              pts = np.exp(1j * (2 * np.pi * np.arange(m) / m + (np.pi / 4 if m == 4 else 0)))
              rot = m
          pts = pts / np.sqrt(np.mean(np.abs(pts) ** 2))
          return digital.constellation_calcdist(list(pts), list(range(m)), rot, 1,
                                                digital.constellation.POWER_NORMALIZATION).base()


      def orden_costas(P):
          return {"bpsk": 2, "8psk": 8}.get(str(P["modulacion"]).lower(), 4)
  states:
    coordinate:
    - 260
    - 153
    rotation: 0
    state: enabled
