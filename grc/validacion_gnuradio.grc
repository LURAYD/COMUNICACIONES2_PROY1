- name: cfo_grueso
  id: epy_block
  parameters:
    _source_code: |
      """Schmidl-Cox: corrección gruesa de frecuencia con el preámbulo [ZC | ZC].

      Es el mismo estimador que usa el receptor de Python (comm2.sync.schmidl_cox):

          P(d) = Σ r*[d+m]·r[d+m+L]          (L = zc_len·sps, las dos mitades)
          M(d) = |P(d)|² / (Ra(d)·Rb(d))      (normalizado con las dos energías)
          CFO  = arg P(d*) · fs / (2π·L)      en el centro de la meseta de M

      Como el preámbulo está al principio de la ráfaga, el bloque retiene las
      primeras muestras (guarda + preámbulo + margen), estima el CFO sobre la señal
      pasada por el filtro adaptado y a partir de ahí deja pasar TODA la señal
      girada en sentido contrario, con fase continua. Rango: |CFO| < fs / (2L).
      """

      import numpy as np
      from gnuradio import gr


      class blk(gr.basic_block):
          def __init__(self, fs=1e6, sps=8, zc_len=64, guard=64, rolloff=0.35, margen=256):
              gr.basic_block.__init__(self, name="Schmidl-Cox (CFO grueso)",
                                      in_sig=[np.complex64], out_sig=[np.complex64])
              self.fs = float(fs)
              self.sps = int(sps)
              self.L = int(zc_len) * int(sps)
              self.rolloff = float(rolloff)
              self.necesita = (int(guard) + 2 * int(zc_len) + int(margen)) * int(sps)
              self.acumulado = []
              self.n_acum = 0
              self.pendiente = None      # muestras retenidas que aun hay que sacar
              self.cfo_hz = 0.0
              self.n = 0                 # muestras ya giradas (fase continua)

          def _estimar(self, r):
              from gnuradio.filter import firdes
              h = np.array(firdes.root_raised_cosine(1.0, self.sps, 1.0, self.rolloff,
                                                     10 * self.sps + 1))
              r = np.convolve(r, h, mode="same")           # filtro adaptado
              L, n = self.L, r.size - 2 * self.L
              if n <= 0:
                  return 0.0
              cp = np.concatenate([[0], np.cumsum(np.conj(r[:-L]) * r[L:])])
              ce = np.concatenate([[0], np.cumsum(np.abs(r) ** 2)])
              P = cp[L:L + n] - cp[:n]
              Ra = ce[L:L + n] - ce[:n]
              Rb = ce[2 * L:2 * L + n] - ce[L:L + n]
              with np.errstate(divide="ignore", invalid="ignore"):
                  M = np.abs(P) ** 2 / (Ra * Rb)
              M[~np.isfinite(M)] = 0.0
              w = max(3, L // 8)
              Ms = np.convolve(M, np.ones(w) / w, mode="same")
              pico = int(np.argmax(Ms))
              lo = hi = pico                                # centro de la meseta (90 %)
              while lo > 0 and Ms[lo - 1] >= 0.9 * Ms[pico]:
                  lo -= 1
              while hi < Ms.size - 1 and Ms[hi + 1] >= 0.9 * Ms[pico]:
                  hi += 1
              return float(np.angle(P[(lo + hi) // 2]) * self.fs / (2 * np.pi * L))

          def _girar(self, x):
              k = self.n + np.arange(x.size)
              self.n += x.size
              return (x * np.exp(-2j * np.pi * self.cfo_hz / self.fs * k)).astype(np.complex64)

          def general_work(self, input_items, output_items):
              x, out = input_items[0], output_items[0]
              if self.pendiente is None:                    # fase de adquisicion
                  self.acumulado.append(np.array(x, copy=True))
                  self.n_acum += len(x)
                  self.consume(0, len(x))
                  if self.n_acum < self.necesita:
                      return 0
                  r = np.concatenate(self.acumulado)
                  self.cfo_hz = self._estimar(r[: self.necesita])
                  print("[Schmidl-Cox] CFO estimado: %.1f Hz" % self.cfo_hz)
                  self.pendiente = r
                  self.acumulado = []
              if self.pendiente.size:                       # primero lo retenido
                  k = min(len(out), self.pendiente.size)
                  out[:k] = self._girar(self.pendiente[:k])
                  self.pendiente = self.pendiente[k:]
                  return k
              k = min(len(x), len(out))
              out[:k] = self._girar(x[:k])
              self.consume(0, k)
              return k
    fs: samp_rate
    sps: sps
    zc_len: int(P['zc_len'])
    guard: int(P['guard'])
    rolloff: float(P['rolloff'])
    margen: '256'
    comment: |-
      Schmidl-Cox: corrige el CFO
      con el preámbulo [ZC ZC]
  states:
    coordinate:
    - 720
    - 1350
    rotation: 0
    state: enabled
