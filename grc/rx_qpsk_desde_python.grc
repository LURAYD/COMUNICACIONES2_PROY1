options:
  parameters:
    author: Comunicaciones II 2026 - Proyecto 1
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Validacion cruzada (seccion 11 de la guia).\nGNU Radio actua como RECEPTOR\
      \ de la MISMA forma de onda generada por\nel simulador de Python (io/py_tx_signal.cf32,\
      \ escrita por\nexperiments/exp6_validacion_grc.py). Al ser identico el transmisor\
      \ y el\ncanal, cualquier diferencia de resultado es atribuible al receptor."
    copyright: ''
    description: Receptor QPSK de GNU Radio sobre la forma de onda de Python
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx_qpsk_desde_python
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RX QPSK sobre senal de Python (Comunicaciones II)
    window_size: (1400,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 12]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: Ramas del banco polifase del sincronizador de temporizacion
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 12]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: "Filtro adaptado interpolado por nfilts,\ncomo pide el bloque Polyphase\
      \ Clock Sync."
    value: firdes.root_raised_cosine(nfilts, nfilts*samp_rate, samp_rate/sps, excess_bw,
      11*sps*nfilts)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: eq_taps
  id: variable
  parameters:
    comment: Numero de taps del ecualizador adaptativo
    value: '21'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 12]
    rotation: 0
    state: enabled
- name: eq_mu
  id: variable
  parameters:
    comment: Paso de adaptacion del LMS dirigido por decision
    value: '0.010'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 12]
    rotation: 0
    state: enabled
- name: qpsk_const
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    type: qpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 92]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: "Forma de onda generada por el simulador\nde Python (complex64).\nLa\
      \ escribe exp6_validacion_grc.py."
    file: io/py_tx_signal.cf32
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 212]
    rotation: 0
    state: enabled
- name: channels_channel_model_0
  id: channels_channel_model
  parameters:
    affinity: ''
    alias: ''
    block_tags: 'False'
    comment: "Mismo canal que en el escenario simulado.\nDesactivar (noise_voltage=0,\
      \ taps=[1])\npara comparar solo el receptor."
    epsilon: '1.0'
    freq_offset: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_voltage: '0.10'
    seed: '2026'
    taps: '[1.0+0.0j]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 196]
    rotation: 0
    state: enabled
- name: digital_pfb_clock_sync_xxx_0
  id: digital_pfb_clock_sync_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: "Filtro adaptado + recuperacion de\ntemporizacion (equivale al lazo de\n\
      Gardner del receptor de Python)."
    filter_size: nfilts
    init_phase: nfilts/2
    loop_bw: '0.020'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    osps: '1'
    sps: sps
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 180]
    rotation: 0
    state: enabled
- name: digital_costas_loop_cc_0
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Recuperacion de portadora (equivale al\nPLL dirigido por decision)."
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
    use_snr: 'False'
    w: '0.0031'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 196]
    rotation: 0
    state: enabled
- name: alg_lms
  id: variable_adaptive_algorithm
  parameters:
    comment: "Algoritmo de adaptacion del ecualizador.\nGNU Radio 3.9 sustituyo los\
      \ bloques\nlms_dd_equalizer_cc / cma_equalizer_cc por\nesta pareja objeto-algoritmo\
      \ + ecualizador.\nOpciones de 'type': lms, nlms, cma."
    cons: qpsk_const
    delta: '10.0'
    ffactor: '.99'
    modulus: '2'
    step_size: eq_mu
    type: lms
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 92]
    rotation: 0
    state: enabled
- name: digital_linear_equalizer_0
  id: digital_linear_equalizer
  parameters:
    adapt_after_training: 'True'
    affinity: ''
    alg: alg_lms
    alias: ''
    comment: "Ecualizador lineal adaptativo.\nCon training_sequence vacia opera\n\
      dirigido por decision: equivale al\nmetodo A del proyecto pero SIN secuencia\n\
      de entrenamiento, que es justo la\ndiferencia que se analiza en el informe."
    maxoutbuf: '0'
    minoutbuf: '0'
    num_taps: eq_taps
    sps: '1'
    training_sequence: '[ ]'
    training_start_tag: '"corr_est"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 188]
    rotation: 0
    state: enabled
- name: blocks_file_sink_sym
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: "Simbolos ecualizados (complex64).\nEl script de Python los sincroniza\
      \ con\nla trama conocida y calcula la BER."
    file: io/grc_rx_symbols.cf32
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 300]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '0.5'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    comment: ''
    grid: 'True'
    gui_hint: 0,0,1,1
    label1: Ecualizado
    legend: 'True'
    marker1: '0'
    name: '"Constelacion tras ecualizacion"'
    nconnections: '1'
    size: '2048'
    style1: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 172]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    autoscale: 'False'
    average: '0.2'
    bw: samp_rate
    color1: '"blue"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '2048'
    freqhalf: 'False'
    grid: 'True'
    gui_hint: 0,1,1,1
    label1: PSD recibida
    legend: 'True'
    name: '"Densidad espectral de potencia"'
    nconnections: '1'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 316]
    rotation: 0
    state: enabled
- name: qtgui_eye_sink_x_0
  id: qtgui_eye_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '0.15'
    autoscale: 'False'
    color1: blue
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: 1,0,1,2
    label1: Signal 1
    legend: 'True'
    marker1: '-1'
    name: '"Diagrama de ojo"'
    nconnections: '1'
    samp_per_symbol: sps
    size: '1024'
    srate: samp_rate
    style1: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_TAG
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '"time_est"'
    type: complex
    update_time: '0.10'
    width1: '1'
    ylabel: Amplitud
    ymax: '2'
    ymin: '-2'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 316]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', channels_channel_model_0, '0']
- [channels_channel_model_0, '0', digital_pfb_clock_sync_xxx_0, '0']
- [channels_channel_model_0, '0', qtgui_freq_sink_x_0, '0']
- [channels_channel_model_0, '0', qtgui_eye_sink_x_0, '0']
- [digital_pfb_clock_sync_xxx_0, '0', digital_costas_loop_cc_0, '0']
- [digital_costas_loop_cc_0, '0', digital_linear_equalizer_0, '0']
- [digital_linear_equalizer_0, '0', qtgui_const_sink_x_0, '0']
- [digital_linear_equalizer_0, '0', blocks_file_sink_sym, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
